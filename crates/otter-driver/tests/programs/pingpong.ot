// One echoing thread, 10,000 round trips, then a clean join.
//
// Each channel holds one value, so the two sides strictly alternate: the main
// thread sends, blocks in `chan_recv`, the echo thread answers, and the main
// thread records the answer. The echo thread counts its own replies and
// returns after the 10,000th, so termination needs no closed channel and the
// join cannot wait on a lost wakeup. The e2e test still runs this under a
// timeout: a lost wakeup on either condition variable would hang it.
//
// The switch arms are single expressions, so the answers are collected into a
// slice and checked after the loop.
fn echo(inbox: Channel[i64], outbox: Channel[i64]) {
    var answered = 0;
    while answered < 10000 {
        switch chan_recv(inbox) {
            case Some(n) {
                chan_send(outbox, n + 1);
            }
            case None {
                // The parent closes `inbox` only after the last round trip.
                chan_send(outbox, -1);
            }
        }
        answered += 1;
    }
}

fn main() {
    var inbox: Channel[i64] = chan_new(1);
    var outbox: Channel[i64] = chan_new(1);
    var handle = thread_spawn(echo, inbox, outbox);

    var answers = []i64 { };
    var i = 0;
    while i < 10000 {
        chan_send(inbox, i);
        switch chan_recv(outbox) {
            case Some(n) {
                push(answers, n);
            }
            case None {
                push(answers, -1);
            }
        }
        i += 1;
    }

    thread_join(handle);

    var ok = len(answers) == 10000;
    var expected = 1;
    for n in answers {
        if n != expected {
            ok = false;
        }
        expected += 1;
    }

    free_slice(answers);
    chan_free(outbox);
    chan_free(inbox);

    if ok {
        print_str("pingpong ok\n");
    } else {
        print_str("pingpong bad\n");
    }
}
