// A method on a struct or an enum: the receiver, the method, and the result.

struct Point { x: i64, y: i64 }

impl Point {
    fn sum(self) -> i64 {
        return self.x + self.y;
    }
}

enum Shape {
    Circle(i64),
    Square(i64),
}

impl Shape {
    fn area(self) -> i64 {
        return switch self {
            case Circle(r) { r * r * 3 }
            case Square(s) { s * s }
        };
    }
}

fn main() {
    const point = Point { x: 2, y: 3 };
    print_i64(point.sum());
    print_str("\n");

    const circle = Shape.Circle(4);
    print_i64(circle.area());
    print_str("\n");
}
