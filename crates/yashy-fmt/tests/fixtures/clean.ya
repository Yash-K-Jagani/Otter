// Arithmetic, a little control flow, and a comment in each position the
// formatter has to keep.
fn add(a: int, b: int) -> int {
    return a + b;
}

fn main() {
    // A standalone line comment.
    let total = 0;
    let i = 0;
    while i < 10 {
        total += add(i, 2); // a trailing line comment
        i += 1;
    }

    /* A block comment
       with a second line. */
    if total > 50 {
        print("big");
    } else {
        print("small");
    }
    print(total);
    println("");
}
