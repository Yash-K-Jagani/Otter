// Arithmetic helpers written in Yashy (M6 Task 10).
//
// Every function here is Yashy source. `sqrt` is Newton's method rather than the
// hardware instruction, and phase 3b's `link_name` does not change that: a
// declaration's *symbol* is what the linker resolves, so `link_name "sqrt"`
// would name the C function correctly, but this module also defines a Yashy
// function called `sqrt`, and a program's functions share the linker's one flat
// namespace with the C functions it declares. The two would be one symbol, and
// the wrapper would call itself. The checker refuses that with `E0900` rather
// than letting `clang` fail. Newton's method needs no C, is exact to the last
// bit for the cases a test pins, and is a useful proof that the language can
// express a numeric routine at all.
//
// Integer results are checked: overflow panics with the operation's position
// rather than wrapping, which is the language default (spec 6.1).
//
// Ownership: every function here is pure; no string, slice, or pointer is
// created or consumed.

// The magnitude of `n`. `abs(int::MIN)` has no representable answer and panics
// rather than wrapping, like every other checked subtraction.
// Ownership: pure; the result is a number.
pub fn abs(n: int) -> int {
    if n < 0 {
        return 0 - n;
    }
    return n;
}

// Ownership: pure; the result is a number.
pub fn min(left: int, right: int) -> int {
    if left < right {
        return left;
    }
    return right;
}

// Ownership: pure; the result is a number.
pub fn max(left: int, right: int) -> int {
    if left > right {
        return left;
    }
    return right;
}

// `base` raised to a non-negative `exponent`, by repeated multiplication.
// Overflow panics. A negative exponent has no integer answer in this signature
// and is refused by the assertion. Ownership: pure; the result is a number.
pub fn pow(base: int, exponent: int) -> int {
    assert(exponent >= 0);
    let result = 1;
    let step = 0;
    while step < exponent {
        result = result * base;
        step = step + 1;
    }
    return result;
}

// The non-negative square root of `x`, by Newton's method.
//
// The iteration is `guess = (guess + x / guess) / 2`; starting from `x` it
// converges to the nearest representable root in well under 32 steps for every
// finite positive input, and squaring the answer lands within a bit of `x`.
// A negative argument panics: there is no real answer, and returning NaN would
// turn a programming mistake into a number that propagates.
// Ownership: pure; the result is a number.
pub fn sqrt(x: float) -> float {
    assert(x >= 0.0);
    if x == 0.0 {
        return 0.0;
    }
    let guess = x;
    let step = 0;
    while step < 32 {
        guess = 0.5 * (guess + x / guess);
        step = step + 1;
    }
    return guess;
}
