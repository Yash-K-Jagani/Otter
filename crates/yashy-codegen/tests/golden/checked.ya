fn checked(a: int, b: int) {
    const sum = a + b;
    const difference = a - b;
    const product = a * b;
    const quotient = a / b;
    const remainder = a % b;
    const negated = -a;
    print(sum);
    print(difference);
    print(product);
    print(quotient);
    print(remainder);
    print(negated);
}
