fn control(x: bool, o: Option[int]) -> int {
    if x {
        print(1);
    } else {
        print(2);
    }

    for i in 0..10 {
        if i == 3 {
            break;
        }
        if i == 5 {
            continue;
        }
    }

    for i := 0; i < 3; print(i) {
        print(i);
    }

    defer {
        print(4);
    }
    defer {
        print(5);
    }

    switch o {
        case None {
            print(0)
        }
        default {
            print(1)
        }
    }

    return 0;
}
