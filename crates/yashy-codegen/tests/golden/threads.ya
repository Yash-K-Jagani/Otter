fn work(n: int) {
    print(n);
}

fn main() {
    let m: Mutex = mutex_new();
    m.lock();
    m.unlock();
    m.free();

    let c: Channel[int] = chan_new(2);
    if c.send(1) {
        print(1);
    }
    switch c.recv() {
        case Some(n) {
            print(n)
        }
        case None {
            print(0)
        }
    }
    c.close();
    c.free();

    let h: int = thread_spawn(work, 7);
    thread_join(h);
}
