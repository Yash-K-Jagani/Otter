fn work(n: int) {
    print_i64(n);
}

fn main() {
    var m: Mutex = mutex_new();
    m.lock();
    m.unlock();
    m.free();

    var c: Channel[int] = chan_new(2);
    if c.send(1) {
        print_i64(1);
    }
    switch c.recv() {
        case Some(n) {
            print_i64(n)
        }
        case None {
            print_i64(0)
        }
    }
    c.close();
    c.free();

    var h: int = thread_spawn(work, 7);
    thread_join(h);
}
