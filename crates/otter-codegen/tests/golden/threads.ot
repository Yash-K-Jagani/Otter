fn work(n: i64) {
    print_i64(n);
}

fn main() {
    var m: Mutex = mutex_new();
    mutex_lock(m);
    mutex_unlock(m);
    mutex_free(m);

    var c: Channel[i64] = chan_new(2);
    if chan_send(c, 1) {
        print_i64(1);
    }
    switch chan_recv(c) {
        case Some(n) {
            print_i64(n)
        }
        case None {
            print_i64(0)
        }
    }
    chan_close(c);
    chan_free(c);

    var h: i64 = thread_spawn(work, 7);
    thread_join(h);
}
