fn checked(a: i64, b: i64) {
    const sum = a + b;
    const difference = a - b;
    const product = a * b;
    const quotient = a / b;
    const remainder = a % b;
    const negated = -a;
    print_i64(sum);
    print_i64(difference);
    print_i64(product);
    print_i64(quotient);
    print_i64(remainder);
    print_i64(negated);
}
