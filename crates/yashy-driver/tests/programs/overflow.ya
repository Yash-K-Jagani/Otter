// Integer overflow is a fault, not a wrap.
//
// `int::MAX + 1` is the canonical case, and printing the maximum first is the
// point: the number in the diagnostic can be compared with the number the
// program printed. A wrapped result would be `int::MIN`, which is a plausible
// answer and a wrong one -- exactly the failure checked arithmetic removes.
fn main() {
    let big = same(9223372036854775807);
    print(big);
    println("");
    print(big + 1);
    println("this line must never be printed");
}

// The value goes through `same` so the verifier cannot see its range: an
// overflow it can prove is rejected at compile time (E1201), and this program
// is about the runtime check, which is what handles a value it does not know.
fn same(n: int) -> int {
    return n;
}
