// Debug formatting: `${value:?}` shows the surface of a value (M15 Task 20).
//
// Display (`${value}`) answers "what does this say?" and has a form for the
// four scalar types only. Debug answers "what is this value?" and has a form
// for the aggregates the language can build: a struct shows its name and its
// fields, an enum shows the variant it holds, a tuple shows its elements, an
// array shows its elements, and a string is quoted and escaped so that a
// newline in it stays visible.
//
// The string case is the point of the last line: the text holds a newline and
// a quote, and the debug form shows both as escapes rather than as the
// characters they are.

struct Point {
    x: int,
    y: int,
}

enum Shape {
    Circle(float),
    Rect { w: float, h: float },
    Empty,
}

fn main() {
    const point = Point { x: 3, y: 4 };
    println("${point:?}");

    const numbers = [1, 2, 3];
    println("${numbers:?}");

    const pair = (1, true);
    println("${pair:?}");

    println("${Shape.Circle(2.5):?}");
    println("${Shape.Rect { w: 2.0, h: 3.0 }:?}");
    println("${Shape.Empty:?}");

    const maybe = Some(7);
    println("${maybe:?}");

    const nothing: Option[int] = None;
    println("${nothing:?}");

    print("${"a\nb\"c":?}\n");

    // The display form is unchanged: `${x}` still prints the number, and the
    // debug form of a number is the same text.
    println("${42} ${42:?}");
}
