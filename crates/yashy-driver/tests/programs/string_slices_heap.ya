// Every element is a freshly built string, so the leak report proves that
// `free` releases the elements' references and not only the backing
// array. The total is the sum of the decimal lengths of 0..99, which also
// proves the values survived the pushes and the iteration.

fn main() {
    let numbers = []string {};
    let i = 0;
    while i < 100 {
        numbers.push(str_from_i64(i));
        i = i + 1;
    }
    let total = 0;
    for number in numbers {
        total = total + number.len();
    }
    print(total);
    println("");
    numbers.free();
}
