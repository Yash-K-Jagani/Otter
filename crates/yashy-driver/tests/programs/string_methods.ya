// String methods. Yashy strings are byte strings, so `len` and `byte_at` count
// bytes, `to_upper`/`to_lower` map ASCII only, and `lines` treats one `\n` as
// one boundary. Every transform returns a fresh owned string.
//
// `show` turns an `Option[i64]` into a printable number: -1 means `None`.

fn show(o: Option[i64]) -> i64 {
    return switch o {
        case Some(v) { v }
        case None { 0 - 1 }
    };
}

fn main() {
    var s = "  Hello, Yashy  ";
    print_i64(s.len());
    print_str("\n");
    if s.is_empty() {
        print_str("unexpected empty\n");
    } else {
        print_str("not empty\n");
    }

    print_i64(s.byte_at(2));
    print_str("\n");
    print_i64(show(s.get(2)));
    print_str("\n");
    print_i64(show(s.get(99)));
    print_str("\n");

    print_str(s.slice(2, 7));
    print_str("\n");

    if s.contains("Yashy") {
        print_str("contains Yashy\n");
    }
    if s.contains("cat") {
        print_str("unexpected: contains cat\n");
    } else {
        print_str("missing cat\n");
    }
    if s.starts_with("  He") {
        print_str("starts He\n");
    }
    if s.ends_with("  ") {
        print_str("ends spaces\n");
    }

    print_i64(show(s.index_of("Yashy")));
    print_str("\n");
    print_i64(show(s.index_of("cat")));
    print_str("\n");

    print_str(s.trim());
    print_str("\n");
    var trimmed_start = s.trim_start();
    print_i64(trimmed_start.len());
    print_str("\n");
    var trimmed_end = s.trim_end();
    print_i64(trimmed_end.len());
    print_str("\n");
    var upper = s.to_upper();
    print_i64(upper.len());
    print_str("\n");
    print_str(upper.trim());
    print_str("\n");
    var lower = s.to_lower();
    print_str(lower.trim());
    print_str("\n");
    var replaced = s.replace("Yashy", "world");
    print_str(replaced.trim());
    print_str("\n");

    var ab = "ab";
    print_str(ab.repeat(3));
    print_str("\n");
    var nothing = ab.repeat(0);
    print_i64(nothing.len());
    print_str("\n");

    var csv = "a, b, c";
    var parts = csv.split(", ");
    print_i64(parts.len());
    print_str("\n");
    for part in parts {
        print_str(part);
        print_str("\n");
    }
    parts.free();

    var one = "abc";
    var whole = one.split("");
    print_i64(whole.len());
    print_str("\n");
    whole.free();

    var trailing = "a,";
    var trailing_parts = trailing.split(",");
    print_i64(trailing_parts.len());
    print_str("\n");
    trailing_parts.free();

    var text = "one\r\ntwo\nthree\n";
    var lines = text.lines();
    print_i64(lines.len());
    print_str("\n");
    for line in lines {
        print_str(line);
        print_str("\n");
    }
    lines.free();

    var empty = "";
    if empty.is_empty() {
        print_str("empty is empty\n");
    }
    var no_lines = empty.lines();
    print_i64(no_lines.len());
    print_str("\n");
    no_lines.free();

    var number = "42";
    print_i64(number.parse_i64());
    print_str("\n");
    var decimal = "2.5";
    if decimal.parse_f64() == 2.5 {
        print_str("f64 parse ok\n");
    } else {
        print_str("f64 parse wrong\n");
    }
}
