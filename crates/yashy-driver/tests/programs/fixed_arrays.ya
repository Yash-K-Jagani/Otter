// Fixed arrays and views.
//
// `[T; N]` is an array whose length is part of its type: the elements live in
// the frame that declares the binding, so there is no allocation and nothing to
// free. `[1, 2, 3]` is a fixed array literal and `grid[i]` is an `Option`: an
// index outside the array answers `None` instead of faulting.
//
// `grid[0..2]` is a *view*: a length and a pointer into `grid`. It owns
// nothing, so `grid` cannot be moved or changed while the view is alive; the
// view itself is only usable inside this function, which is what keeps the
// pointer from outliving the array.

fn show(o: Option[int]) -> int {
    return switch o {
        case Some(v) { v }
        case None { 0 - 1 }
    };
}

fn make_grid() -> [int; 3] {
    return [1, 2, 3];
}

// A view of a growable array. The view borrows the parameter until the call
// returns, so the callee cannot free the array it was handed: the borrow rule
// has no way to end early, and freeing under a live view is exactly the
// dangling pointer the rule exists to prevent. That is a leak, not a
// corruption -- the price of views in a language with no lifetime syntax.
fn middle_sum(xs: []int) -> int {
    const mid = xs[1..3];
    let sum = 0;
    for value in mid {
        sum = sum + value;
    }
    return sum;
}

fn main() {
    let grid = make_grid();

    // A fixed array's length is a constant in its type.
    print(grid.len());
    println("");

    // Indexing is checked, in range and out.
    print(show(grid[1]));
    println("");
    print(show(grid[3]));
    println("");
    print(show(grid.first()));
    println("");
    print(show(grid.last()));
    println("");

    // A view over the middle of the array. Bounds are clamped, so `0..99` is
    // the whole array rather than an error.
    const head = grid[0..2];
    print(head.len());
    println("");

    let total = 0;
    for value in head {
        total = total + value;
    }
    print(total);
    println("");

    // Iterating the array itself visits every element.
    let all = 0;
    for value in grid {
        all = all + value;
    }
    print(all);
    println("");

    const wide = grid[0..99];
    print(wide.len());
    println("");

    // A backwards range is empty, not negative.
    const none = grid[2..1];
    print(none.len());
    println("");

    // Fixed arrays can be named in a type too.
    const typed: [int; 2] = [7, 8];
    print(show(typed[1]));
    println("");

    // A view over a growable array: 20 + 30.
    print(middle_sum([]int { 10, 20, 30, 40 }));
    println("");
    // => 3
    //    2
    //    -1
    //    1
    //    3
    //    2
    //    3
    //    6
    //    3
    //    0
    //    8
    //    50
}
