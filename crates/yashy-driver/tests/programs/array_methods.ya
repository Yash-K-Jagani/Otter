// The array surface is methods now. `xs.len()` counts, `xs.push(3)` appends,
// and `xs.free()` releases the backing array.
// The method spelling is the one the M12 surface will keep.

fn main() {
    var xs = []i64 { 1, 2 };
    print_i64(xs.len());
    print_str("\n");
    xs.push(3);
    print_i64(xs.len());
    print_str("\n");
    xs.free();
}
