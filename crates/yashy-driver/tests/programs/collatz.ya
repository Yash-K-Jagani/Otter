// `while` is the loop for "keep going until something changes": the condition
// is at the top, where a reader looks for it, and the body is what moves it.
// It is the same node as `for ; cond; { }`, so it costs the backend nothing.
//
// `n /= 2` and `steps += 1` are the expanded assignment written short: the
// parser turns each into `n = n / 2` and `steps = steps + 1`, so the two
// spellings are the same program.

fn collatz_steps(start: int) -> int {
    var n = start;
    var steps = 0;
    while n != 1 {
        if n % 2 == 0 {
            n /= 2;
        } else {
            n = 3 * n + 1;
        }
        steps += 1;
    }
    return steps;
}

fn main() {
    var i = 1;
    while i <= 5 {
        print_str(str_from_i64(i) + ": " + str_from_i64(collatz_steps(i)) + "\n");
        i += 1;
    }
}
