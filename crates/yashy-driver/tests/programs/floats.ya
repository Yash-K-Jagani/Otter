// Floating-point arithmetic, end to end.
//
// This program exists because of a real defect. `1.0 + 2.0` used to lower to
// `add double`, and `3.0 * 4.0` to `mul double`. `add` and `mul` are LLVM's
// *integer* opcodes: the emitted IR was rejected by `clang` outright. The unit
// tests missed it because the golden file had recorded that broken IR as the
// expected output, and no end-to-end program did any f64 arithmetic at all.
//
// So the point of this file is not the numbers. It is that every float operator
// here has to survive `clang` before the test can pass, and that a literal small
// enough to print in exponent form (`0.0000001`) has to be spelled in a way
// LLVM's float grammar accepts.
//
// Each result is cast to i64 before printing so the expected output does not
// depend on how the C library formats a double.
fn main() {
    const add = 1.0 + 2.0;
    const sub = 5.0 - 3.0;
    const mul = 3.0 * 4.0;
    const div = 6.0 / 2.0;
    const rem = 7.0 % 3.0;
    const neg = -2.5;
    const tiny = 0.0000001;

    print_i64(add as i64);
    print_str("\n");
    print_i64(sub as i64);
    print_str("\n");
    print_i64(mul as i64);
    print_str("\n");
    print_i64(div as i64);
    print_str("\n");
    print_i64(rem as i64);
    print_str("\n");
    print_i64(neg as i64);
    print_str("\n");
    print_i64(tiny as i64);
    print_str("\n");
}
