// One echoing thread, 10,000 round trips, then a clean join.
//
// Each channel holds one value, so the two sides strictly alternate: the main
// thread sends, blocks in `recv`, the echo thread answers, and the main
// thread records the answer. The echo thread counts its own replies and
// returns after the 10,000th, so termination needs no closed channel and the
// join cannot wait on a lost wakeup. The e2e test still runs this under a
// timeout: a lost wakeup on either condition variable would hang it.
//
// The switch arms are single expressions, so the answers are collected into a
// slice and checked after the loop.
fn echo(inbox: Channel[int], outbox: Channel[int]) {
    let answered = 0;
    while answered < 10000 {
        switch inbox.recv() {
            case Some(n) {
                outbox.send(n + 1);
            }
            case None {
                // The parent closes `inbox` only after the last round trip.
                outbox.send(-1);
            }
        }
        answered += 1;
    }
}

fn main() {
    let inbox: Channel[int] = chan_new(1);
    let outbox: Channel[int] = chan_new(1);
    let handle = thread_spawn(echo, inbox, outbox);

    let answers = []int { };
    let i = 0;
    while i < 10000 {
        inbox.send(i);
        switch outbox.recv() {
            case Some(n) {
                answers.push(n);
            }
            case None {
                answers.push(-1);
            }
        }
        i += 1;
    }

    thread_join(handle);

    let ok = answers.len() == 10000;
    let expected = 1;
    for n in answers {
        if n != expected {
            ok = false;
        }
        expected += 1;
    }

    answers.free();
    outbox.free();
    inbox.free();

    if ok {
        println("pingpong ok");
    } else {
        println("pingpong bad");
    }
}
