// A `defer` belongs to the block it is written in, not to the first nested
// block that happens to finish. The body runs once, when `main`'s block ends,
// after every nested `if` and both loop forms have completed. Running it at the
// end of the `if` branch or at the end of an iteration would print "deferred"
// earlier and more than once.
fn main() {
    defer {
        println("deferred");
    }
    if 1 == 1 {
        println("if");
    }
    var xs = []int { 7, 8 };
    for value in xs {
        print(value);
        print(" ");
    }
    for i in 0..2 {
        print(i);
        print(" ");
    }
    println("after");
    xs.free();
}
