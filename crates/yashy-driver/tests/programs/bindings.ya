// The three binding forms, end to end. `let` and `let` are mutable; `const` is
// not. All three are block-scoped today, so the nested `let` in this program is
// only visible inside its block -- the assignment on the next line uses the
// outer `total`, not the inner `let`.

fn main() {
    let x: int = 1;
    x = x + 1;
    print(x);
    println("");

    let total = 0;
    if true {
        let inner = 40;
        total = inner + 2;
    }
    print(total);
    println("");

    const limit = 3;
    print(limit);
    println("");
}
