// Function values: a top-level function name is a value, it can be passed
// to another function and called through the parameter, and it can be bound
// to a local and called through that binding.

fn square(x: int) -> int {
    return x * x;
}

fn apply(f: fn(int) -> int, x: int) -> int {
    return f(x);
}

fn main() {
    print(apply(square, 7));
    println("");

    const f = square;
    print(f(4));
    println("");
}
