// The map's key and value methods, end to end.
//
// `keys` and `values` hand back a fresh array of the table's own contents.
// The order is the table's order -- a hash table has no insertion order to
// give away -- so this program measures the arrays rather than printing them
// in order: it counts them, sums the values, and asks `contains_key` about
// each key. The key array owns its own reference to every string it holds,
// so the map can be freed while the array is still alive.

fn main() {
    let scores: map[string]int = map_new();
    scores.insert("ada", 10);
    scores.insert("bram", 20);
    scores.insert("cy", 30);

    let keys: []string = scores.keys();
    let values: []int = scores.values();

    print(keys.len());
    println("");
    print(values.len());
    println("");

    let total: int = 0;
    for v in values {
        total = total + v;
    }
    print(total);
    println("");

    if scores.contains_key("ada") {
        println("has ada");
    }
    if scores.contains_key("zz") {
        println("has zz");
    } else {
        println("no zz");
    }

    // The map goes first: the key array holds a reference of its own, so the
    // strings it carries stay alive.
    scores.free();

    let kept: int = 0;
    for k in keys {
        kept = kept + k.len();
    }
    print(kept);
    println("");

    keys.free();
    values.free();

    // A `bool` value is one byte, so the value array's stride is one byte
    // rather than eight: the copy has to keep the bytes it copied.
    let flags: map[int]bool = map_new();
    flags.insert(1, true);
    flags.insert(2, false);
    let flag_values: []bool = flags.values();
    let trues = 0;
    for v in flag_values {
        if v {
            trues = trues + 1;
        }
    }
    print(trues);
    println("");
    flag_values.free();
    flags.free();
}
