// One release spelling: `.free()` on every owning value.
//
// A pointer is linear, so freeing it consumes the binding. A slice and a map
// own their storage too, and the same method releases them. The markers prove
// each call returns and the process stays healthy afterwards.
fn main() {
    let p = alloc(4);
    p.free();
    println("pointer freed");

    let xs = []int { 1, 2, 3 };
    xs.free();
    println("slice freed");

    let m: map[int]int = map_new();
    m.insert(1, 2);
    m.free();
    println("map freed");
}
