// `defer` runs when its scope exits, last registered first, and the body sees
// the values that were live when the `defer` was *reached* -- not whatever the
// slots happen to hold at exit. Both properties are visible in the output here.
fn main() {
    var buf = alloc(16);
    defer {
        dealloc(buf);
        println("second");
    }
    defer {
        println("first");
    }
    println("body");
}
