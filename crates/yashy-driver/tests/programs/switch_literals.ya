// Literal `switch` arms compare the subject itself, not a variant tag.
//
// This program exists because they did not: `gen_match` derived a test only
// from a variant's tag, so a literal arm became an untested arm -- and an
// untested arm is the fall-through target. Every value therefore matched the
// first literal arm, and `classify(9)` answered "zero". Each case below has a
// value that must *not* match, which is the half that used to be wrong, and the
// strings check the runtime comparison on both a prefix ("yashy") and a longer
// string ("yashy!").
fn classify(n: int) -> string {
    return switch n {
        case 0 { "zero" }
        case 1 { "one" }
        default { "many" }
    };
}

fn name(text: string) -> string {
    return switch text {
        case "yashy" { "animal" }
        case "yashy!" { "shout" }
        default { "other" }
    };
}

fn half(value: float) -> string {
    return switch value {
        case 1.5 { "one and a half" }
        default { "other" }
    };
}

fn flag(value: bool) -> string {
    return switch value {
        case true { "yes" }
        default { "no" }
    };
}

fn main() {
    print(classify(0));
    print(" ");
    print(classify(1));
    print(" ");
    print(classify(9));
    println("");

    print(name("yashy"));
    print(" ");
    print(name("yashy!"));
    print(" ");
    print(name("nope"));
    println("");

    print(half(1.5));
    print(" ");
    print(half(2.5));
    println("");

    print(flag(true));
    print(" ");
    print(flag(false));
    println("");
}
