// Reads a name and an age, then prints a sentence built from both.
//
// This is the pair a program needs to *produce* text rather than just print
// pieces of it: `read_line` gets the input, and `str_from_i64` puts a number
// inside a string, so the whole sentence is one value.
fn main() {
    print("name? ");
    const name = read_line();
    print("age? ");
    const age_text = read_line();
    const age = age_text.parse_i64();
    print(name + " is " + str_from_i64(age) + " years old\n");
}
