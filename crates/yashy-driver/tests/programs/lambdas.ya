// A lambda is a function value written where a value is expected.
//
// The first lambda is handed straight to `apply`, which calls it through its
// parameter. The second is bound first and called through the binding.

fn apply(f: fn(int) -> int, x: int) -> int {
    return f(x);
}

fn main() {
    print_i64(apply(|x: int| -> int { return x + 1; }, 41));
    print_str("\n");

    const double = |x: int| -> int { return x * 2; };
    print_i64(double(20));
    print_str("\n");
}
