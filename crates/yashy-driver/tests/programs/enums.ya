// User-declared enums: construction, matching, and payload extraction.
//
// `Shape` covers the three variant shapes (positional, named, unit) and a
// named payload written out of declaration order. `Message` puts a unit
// variant *first*, so a payload that assumed tag == payload index would read
// the wrong field: `Text` is tag 1 but payload field 1, `Count` is tag 2 but
// payload field 2, and `Nothing` owns tag 0 with no payload at all. `Item`
// makes the payload a struct, so the variant carries an aggregate and a
// binding on it still supports field access.
struct Pair {
    left: int,
    right: int,
}

enum Shape {
    Circle(float),
    Rect { w: float, h: float },
    Point,
}

enum Message {
    Nothing,
    Text(string),
    Count(int),
}

enum Item {
    Nothing,
    Two(Pair),
    Number(int),
}

fn area(s: Shape) -> float {
    return switch s {
        case Circle(r) { 3.0 * r * r }
        case Rect { w: w, h: h } { w * h }
        case Point { 0.0 }
    };
}

fn label(m: Message) -> string {
    return switch m {
        case Text(t) { t }
        case Count(n) { "count" }
        case Nothing { "nothing" }
    };
}

fn total(item: Item) -> int {
    return switch item {
        case Two(p) { p.left + p.right }
        case Number(n) { n }
        case Nothing { 0 }
    };
}

fn main() {
    const c = Shape.Circle(2.0);
    const r = Shape.Rect { h: 3.0, w: 4.0 };
    const p = Shape.Point;
    print(area(c));
    println("");
    print(area(r));
    println("");
    print(area(p));
    println("");

    print(label(Message.Text("hi")));
    println("");
    print(label(Message.Count(7)));
    println("");
    print(label(Message.Nothing));
    println("");

    print(total(Item.Two(Pair { right: 3, left: 4 })));
    println("");
    print(total(Item.Number(5)));
    println("");
    print(total(Item.Nothing));
    println("");
}
