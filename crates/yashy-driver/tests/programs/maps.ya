// Maps, end to end: insert, overwrite, lookup, remove, and measure.
//
// The keys are `string`, so this also exercises content hashing: `"apple"`
// inserted three times is one entry, and the value is the last one written.
// Every arm prints a witness, and `get`/`remove` answer in an `Option[]`
// rather than failing, so a missing key has its own line.

fn report(found: Option[i64]) {
    switch found {
        case Some(v) { print_i64(v); }
        case None { print_str("none"); }
    }
    print_str("\n");
}

fn main() {
    var counts: map[string]i64 = map_new();
    counts.insert("apple", 2);
    counts.insert("pear", 3);
    counts.insert("apple", 5);
    report(counts.get("apple"));
    report(counts.remove("pear"));
    report(counts.get("pear"));
    print_i64(counts.len());
    print_str("\n");
    counts.free();
}
