// Closing a channel releases a sender that is blocked on it.
//
// `slot` holds one value, so the producer's second send to it cannot complete
// until somebody receives -- and nobody ever does. The producer proves it got
// that far by sending on `full`, which wakes the main thread; the main thread
// then closes `slot` instead of draining it, and the blocked send must answer
// false rather than hang. The join is the proof.
fn producer(slot: Channel[int], full: Channel[int]) {
    slot.send(1);
    // The slot is now full: this send is the signal that the next one blocks.
    full.send(1);
    slot.send(2);
}

fn main() {
    let slot: Channel[int] = chan_new(1);
    let full: Channel[int] = chan_new(1);
    let handle = thread_spawn(producer, slot, full);

    switch full.recv() {
        case Some(n) {
            println("full");
        }
        case None {
            println("empty");
        }
    }

    slot.close();
    thread_join(handle);
    full.free();
    slot.free();

    println("unblocked");
}
