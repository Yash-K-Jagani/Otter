// Array search, extend, and copy-slice methods. `contains`/`index_of` compare
// element contents, `extend` consumes the array it is given, and `slice`
// copies a clamped range into a fresh array. The `[]string` section checks the
// retain/release path for both extend and slice.
//
// `show` turns an `Option[int]` into a printable number: -1 means `None`.

fn show(o: Option[int]) -> int {
    return switch o {
        case Some(v) { v }
        case None { 0 - 1 }
    };
}

fn main() {
    var xs = []int { 10, 20, 30 };
    if xs.contains(20) {
        println("contains 20");
    }
    if xs.contains(99) {
        println("unexpected: contains 99");
    } else {
        println("missing 99");
    }
    print(show(xs.index_of(30)));
    println("");
    print(show(xs.index_of(99)));
    println("");

    xs.extend([]int { 40, 50 });
    print(xs.len());
    println("");
    for x in xs {
        print(x);
        println("");
    }

    var part = xs.slice(1, 4);
    for x in part {
        print(x);
        println("");
    }
    part.free();

    var clamped = xs.slice(0 - 5, 2);
    for x in clamped {
        print(x);
        println("");
    }
    clamped.free();

    var tail = xs.slice(2, 99);
    for x in tail {
        print(x);
        println("");
    }
    tail.free();

    xs.free();

    var names = []string { "a", "b" };
    names.extend([]string { "c", "d" });
    if names.contains("c") {
        println("contains c");
    }
    print(show(names.index_of("b")));
    println("");
    print(names.len());
    println("");

    var middle = names.slice(1, 3);
    for name in middle {
        print(name);
        println("");
    }
    middle.free();
    names.free();
}
