// The slice operations beyond the literal: length, indexing (always an
// `Option`), `pop`, and iteration. Every printed line is a claim the runtime
// can only satisfy if `get` bounds-checks, `pop` shrinks the header, and the
// loop re-reads the header after a `push` grows the backing array.
//
// `show` answers -1 for `None`: `switch` arms are single expressions in this
// milestone, so the two cases have to agree on one result type.
fn show(o: Option[int]) -> int {
    return switch o {
        case Some(v) { v }
        case None { 0 - 1 }
    };
}

fn main() {
    let xs = []int { 10, 20, 30 };
    xs.push(40);
    print(xs.len());
    println("");

    print(show(xs[0]));
    println("");
    print(show(xs[3]));
    println("");
    print(show(xs[4]));
    println("");
    print(show(xs[0 - 1]));
    println("");

    let sum = 0;
    for value in xs {
        sum = sum + value;
    }
    print(sum);
    println("");

    let before = 0;
    for value in xs {
        if value == 20 {
            break;
        }
        before = before + 1;
    }
    print(before);
    println("");

    let empty = []int {};
    let count = 0;
    for value in empty {
        count = count + 1;
    }
    print(count);
    println("");

    // The loop must see a `push` that happens while it runs. A cached length or
    // data pointer would stop after the first iteration (or read freed memory).
    let growing = []int { 1 };
    let pushed = 0;
    for value in growing {
        if pushed == 3 {
            break;
        }
        growing.push(value + 1);
        pushed = pushed + 1;
    }
    print(growing.len());
    println("");

    print(show(xs.pop()));
    println("");
    print(show(xs.pop()));
    println("");
    print(xs.len());
    println("");

    empty.free();
    growing.free();
    xs.free();
}
