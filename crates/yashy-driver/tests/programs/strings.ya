// Strings, end to end: `+` concatenates, `len` counts bytes, and `==`/`!=`
// compare contents rather than addresses.
//
// Every one of those is a runtime call, because a `string` value is a pointer to
// bytes rather than something the arithmetic instructions can take. The program
// also pins the entry point's exit status: its last statement is a comparison
// that returns 1, which is exactly what a `void main` would have left as the
// process exit code. The test asserting this program exits zero is therefore
// also the regression test for that.

fn bracket(text: string) -> string {
    return "[" + text + "]";
}

fn main() {
    const greeting = "Hello, " + "Yashy!";
    print(greeting);
    println("");
    print(greeting.len());
    println("");
    print(bracket("x"));
    println("");
    const empty = "";
    print(empty.len());
    println("");
    if greeting == "Hello, Yashy" {
        println("unexpected: the `!` was dropped");
    }
    if greeting != "Hello, Yashy" {
        println("different");
    }
    if greeting == "Hello, Yashy!" {
        println("equal");
    }
}
