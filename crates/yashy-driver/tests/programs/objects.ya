// An object declaration: a type with its fields and its methods together.

object Counter {
    value: int,
    fn get(self) -> int {
        return self.value;
    },
    fn add(self, n: int) -> Counter {
        return Counter { value: self.value + n };
    },
}

fn main() {
    const counter = Counter { value: 3 };
    print(counter.get());
    println("");

    // A method called on the result of another one.
    print(counter.add(4).get());
    println("");
}
