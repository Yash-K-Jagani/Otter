// Maps that own their keys: every key is a built string, the table retains it,
// and `free` releases it.
//
// The leak report at exit is the assertion. A non-zero count means the table
// kept a reference it never dropped, or retained a key twice; both are the kind
// of bug a program with only literal keys cannot show, because a literal is
// static and is never freed either way.

fn main() {
    let m: map[string]int = map_new();
    let i = 0;
    while i < 200 {
        let key = str_from_i64(i);
        m.insert(key, i);
        i = i + 1;
    }
    let probe = str_from_i64(150);
    let found = m.get(probe);
    switch found {
        case Some(v) { print(v); }
        case None { print("missing"); }
    }
    println("");
    print(m.len());
    println("");
    m.free();
}
