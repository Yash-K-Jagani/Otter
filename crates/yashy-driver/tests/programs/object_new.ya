// A static method: one that belongs to the type rather than to a value of it.

object Counter {
    value: int,
    fn new(start: int) -> Counter {
        return Counter { value: start };
    },
    fn get(self) -> int {
        return self.value;
    },
}

fn main() {
    print_i64(Counter.new(3).get());
    print_str("\n");
}
