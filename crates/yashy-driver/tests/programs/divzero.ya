// Division by zero is a fault, not a hardware trap.
//
// The checker inserts the divisor check before the `sdiv`, so the failing
// operation never reaches an instruction that would raise `#DE`. The runtime
// prints the position it was written at, the operator, and both operands, then
// exits 1 -- and the line after the call never runs.
//
// The first division is there so the output proves the program got that far; a
// crash before it would print nothing.
fn divide(a: int, b: int) -> int {
    return a / b;
}

fn main() {
    print(divide(10, 2));
    println("");
    print(divide(10, 0));
    println("this line must never be printed");
}
