// Tuples, destructuring, and pattern guards.
//
// `min_max` returns both answers at once as a `(int, int)`, and every binding
// in this program unpacks one: `const` for a fixed pair, `var`/`let` for the
// mutable ones, `_` for the element that is not wanted, `(only,)` for the
// one-element spelling, and a second destructuring for a nested tuple.
//
// `classify` and `bucket` are about guards. A guard is checked after the
// pattern has bound its names, and a false guard means "this arm did not
// match" -- the search continues exactly as if the pattern had failed. The
// last arms are unguarded on purpose: a guard cannot stand in for a case
// that covers everything, because it can always say no.

enum Shape {
    Circle(float),
    Rect { w: float, h: float },
    Dot,
}

fn min_max(a: int, b: int) -> (int, int) {
    if a < b {
        return (a, b);
    }
    return (b, a);
}

fn sum(pair: (int, int)) -> int {
    const (a, b) = pair;
    return a + b;
}

fn classify(shape: Shape) -> string {
    return switch shape {
        case Circle(r) if r > 10.0 { "big circle" }
        case Circle(r) { "small circle" }
        case Rect { w: w, h: h } if w == h { "square" }
        case Rect { w: w, h: h } { "rectangle" }
        case Dot { "dot" }
    };
}

fn bucket(n: int) -> int {
    return switch n {
        case 0 { 100 }
        // A guard on a pattern that matches everything still has a place in
        // the search order: when the guard says no, the `default` below is
        // reached rather than skipped.
        case _ if n < 0 { 200 }
        default { 300 }
    };
}

fn main() {
    const pair = min_max(9, 4);
    const (lo, hi) = pair;
    print(lo);
    println("");
    print(hi);
    println("");

    // `_` skips an element; `var` leaves the remaining one assignable.
    var (first, _) = min_max(2, 7);
    first = first + 1;
    print(first);
    println("");

    // A one-element tuple is the spelling with the trailing comma.
    const single = (5,);
    const (only,) = single;
    print(only);
    println("");

    // A tuple is an ordinary value: it can be passed and returned.
    print(sum(pair));
    println("");

    // Nested tuples unpack one layer at a time.
    const nested = (1, (2, 3));
    const (x, rest) = nested;
    const (y, z) = rest;
    print(x + y + z);
    println("");

    print(classify(Shape.Circle(20.0)));
    println("");
    print(classify(Shape.Circle(2.0)));
    println("");
    print(classify(Shape.Rect { w: 3.0, h: 3.0 }));
    println("");
    print(classify(Shape.Rect { w: 3.0, h: 4.0 }));
    println("");
    print(classify(Shape.Dot));
    println("");

    print(bucket(0));
    println("");
    print(bucket(0 - 5));
    println("");
    print(bucket(5));
    println("");

    let (small, large) = min_max(3, 8);
    large = large + 1;
    print(small + large);
    println("");
}
