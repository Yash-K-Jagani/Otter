// Array query and update methods. `first`/`last` are `get(0)`/`get(len - 1)`,
// so an empty array answers `None` rather than faulting. `set` returns `false`
// when the index is outside the array, and the array is unchanged.
//
// `show` turns an `Option[int]` into a printable number: -1 means `None`.

fn show(o: Option[int]) -> int {
    return switch o {
        case Some(v) { v }
        case None { 0 - 1 }
    };
}

fn main() {
    var empty = []int {};
    if empty.is_empty() {
        println("empty is empty");
    }
    print(show(empty.first()));
    println("");
    print(show(empty.last()));
    println("");

    var xs = []int { 10, 20, 30 };
    if xs.is_empty() {
        println("unexpected: not empty");
    } else {
        println("xs is not empty");
    }
    print(show(xs.get(1)));
    println("");
    print(show(xs.get(3)));
    println("");
    print(show(xs.first()));
    println("");
    print(show(xs.last()));
    println("");

    if xs.set(1, 99) {
        println("set in range");
    } else {
        println("unexpected: set missed");
    }
    print(show(xs.get(1)));
    println("");

    if xs.set(3, 1) {
        println("unexpected: set accepted an out-of-range index");
    } else {
        println("set out of range");
    }

    empty.free();
    xs.free();
}
