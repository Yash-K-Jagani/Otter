// Benchmark 1b: the same recursive Fibonacci, with the arithmetic opt-out.
//
// `fib.ot` is plain `+` and `-`, which in Otter are checked: the program stops
// with a message naming the operands if they overflow. C, Rust, Go, Node and
// Python all wrap instead, so `fib.ot` is not strictly the same program as
// `fib.c` -- it promises more.
//
// This file is that promise withdrawn, spelled with the opt-out the language
// provides for exactly this case. It is the row to read beside `fib.c` when the
// question is codegen quality rather than language semantics, and the pair
// (`fib.ot` vs this file) is what the check costs on a call-dominated program.
//
// The inputs here cannot overflow in the first place -- fib(35) peaks around
// 15 million -- so both variants return the same number; the difference is
// entirely in the instructions the compiler emits.
fn fib(n: i64) -> i64 {
    if n < 2 {
        return n;
    }
    return wrapping_add(fib(wrapping_sub(n, 1)), fib(wrapping_sub(n, 2)));
}

fn main() {
    print_i64(fib(35));
    print_str("\n");
}
