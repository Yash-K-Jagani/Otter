// One million integer keys inserted, then looked up.
//
// Every key is distinct, so the table grows to its full size and every lookup
// has to find a real entry. The saved value is `3 * key`, which makes a wrong
// lookup visible in the printed sum rather than merely slow.
fn main() {
    const n = 1000000;
    var m: map[int]int = map_new();
    var i = 0;
    while i < n {
        m.insert(i, i * 3);
        i = wrapping_add(i, 1);
    }

    var sum = 0;
    var j = 0;
    while j < n {
        sum = wrapping_add(sum, switch m.get(j) {
            case Some(v) {
                v
            }
            case None {
                0
            }
        });
        j = wrapping_add(j, 1);
    }

    print(sum);
    println("");
    m.free();
}
