// One million contended lock/unlock pairs, split across four threads.
//
// The critical section is empty on purpose: this measures what the mutex
// itself costs when four threads queue for it, not the work inside. (Yashy
// does not let a `*mut` cross a thread boundary yet, so a shared counter is
// the runtime's own test, not something user code can write.)
fn worker(gate: Mutex, rounds: int) {
    var i = 0;
    while i < rounds {
        gate.lock();
        gate.unlock();
        i = wrapping_add(i, 1);
    }
}

fn main() {
    const rounds = 250000;
    var gate = mutex_new();

    var a = thread_spawn(worker, gate, rounds);
    var b = thread_spawn(worker, gate, rounds);
    var c = thread_spawn(worker, gate, rounds);
    var d = thread_spawn(worker, gate, rounds);

    thread_join(a);
    thread_join(b);
    thread_join(c);
    thread_join(d);

    gate.free();
    print_i64(wrapping_mul(rounds, 4));
    print_str("\n");
}
