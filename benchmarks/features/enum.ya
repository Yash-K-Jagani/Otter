// Building and matching a three-variant enum, 50 million times.
//
// The payload is an int, so the enum is the same shape as the C tagged struct
// in enum.c: one tag byte and one payload slot. `make` chooses a variant from
// the iteration index and `score` switches on it; every iteration crosses both
// calls, so the row measures construction and dispatch rather than arithmetic.
enum Msg {
    Num(int),
    Twice(int),
    Nothing,
}

fn make(i: int) -> Msg {
    const r = i % 3;
    if r == 0 {
        return Msg.Num(i);
    }
    if r == 1 {
        return Msg.Twice(i);
    }
    return Msg.Nothing;
}

fn score(m: Msg) -> int {
    return switch m {
        case Num(n) { n }
        case Twice(n) { wrapping_add(n, n) }
        case Nothing { 0 }
    };
}

fn main() {
    const n = 50000000;
    var i = 0;
    var sum = 0;
    while i < n {
        sum = wrapping_add(sum, score(make(i)));
        i = wrapping_add(i, 1);
    }
    print_i64(sum);
    print_str("\n");
}
