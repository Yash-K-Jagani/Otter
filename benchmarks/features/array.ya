// Growing an array by `push`, then summing it.
//
// Nothing is preallocated: the runtime doubles the backing array when it fills,
// so this measures the growth policy and the copy each time it triggers, not a
// pre-sized buffer. The C, Go and Rust rows append to a dynamic array too.
//
// After the sum, one pass of the M12 query, edit, search, extend and copy
// methods exercises their runtime entry points. Those calls are outside the
// measured loop, so the growth comparison is unchanged, but the benchmark stops
// compiling if method resolution or a new runtime entry point regresses.
fn option_i64(o: Option[int]) -> int {
    return switch o {
        case Some(v) { v }
        case None { 0 - 1 }
    };
}

fn main() {
    const n = 10000000;
    let xs = []int {};
    let i = 0;
    while i < n {
        xs.push(i);
        i = wrapping_add(i, 1);
    }

    let sum = 0;
    for x in xs {
        sum = wrapping_add(sum, x);
    }
    print(sum);
    println("");

    if xs.is_empty() {
        println("unexpected empty");
    }
    if option_i64(xs.first()) != 0 {
        println("bad first");
    }
    if option_i64(xs.last()) != 9999999 {
        println("bad last");
    }
    if !xs.set(0, 0) {
        println("set failed");
    }
    if option_i64(xs.get(0)) != 0 {
        println("bad get");
    }
    if !xs.contains(0) {
        println("missing contains");
    }
    if option_i64(xs.index_of(9999999)) != 9999999 {
        println("bad index_of");
    }
    let extra = []int { 1, 2 };
    xs.extend(extra);
    let copy = xs.slice(0, 3);
    if copy.len() != 3 {
        println("bad array");
    }
    copy.free();
    xs.free();

    // The M12 string method surface, also outside the measured loop. These
    // checks keep the method resolver and the string runtime entry points in a
    // binary that the feature suite builds and runs.
    let text = "  Yashy,yashy  ";
    let trimmed = text.trim();
    if trimmed.len() != 11 {
        println("bad trim");
    }
    let upper = text.to_upper();
    if upper.len() != 15 {
        println("bad to_upper");
    }
    let lower = text.to_lower();
    if lower.len() != 15 {
        println("bad to_lower");
    }
    let replaced = text.replace("yashy", "seal");
    if replaced.len() != 14 {
        println("bad replace");
    }
    let piece = text.slice(2, 7);
    if piece.len() != 5 {
        println("bad string slice");
    }
    let dash = "-";
    let repeated = dash.repeat(3);
    if repeated.len() != 3 {
        println("bad repeat");
    }
    let parts = text.split(",");
    if parts.len() != 2 {
        println("bad split");
    }
    parts.free();
    let lines = text.lines();
    if lines.len() != 1 {
        println("bad lines");
    }
    lines.free();
    if !text.contains("yashy") {
        println("missing contains");
    }
    if !text.starts_with("  ") {
        println("bad starts_with");
    }
    if !text.ends_with("  ") {
        println("bad ends_with");
    }
    if text.byte_at(2) != 89 {
        println("bad byte_at");
    }
    if option_i64(text.get(2)) != 89 {
        println("bad string get");
    }
    if option_i64(text.index_of("yashy")) != 8 {
        println("bad string index_of");
    }
    let empty = "";
    if !empty.is_empty() {
        println("empty string is not empty");
    }
    let number = "42";
    if number.parse_i64() != 42 {
        println("bad parse_i64");
    }
    let decimal = "2.5";
    if decimal.parse_f64() != 2.5 {
        println("bad parse_f64");
    }
}
