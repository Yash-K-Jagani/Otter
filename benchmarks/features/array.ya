// Growing an array by `push`, then summing it.
//
// Nothing is preallocated: the runtime doubles the backing array when it fills,
// so this measures the growth policy and the copy each time it triggers, not a
// pre-sized buffer. The C, Go and Rust rows append to a dynamic array too.
//
// After the sum, one pass of the M12 query, edit, search, extend and copy
// methods exercises their runtime entry points. Those calls are outside the
// measured loop, so the growth comparison is unchanged, but the benchmark stops
// compiling if method resolution or a new runtime entry point regresses.
fn option_i64(o: Option[int]) -> int {
    return switch o {
        case Some(v) { v }
        case None { 0 - 1 }
    };
}

fn main() {
    const n = 10000000;
    var xs = []int {};
    var i = 0;
    while i < n {
        xs.push(i);
        i = wrapping_add(i, 1);
    }

    var sum = 0;
    for x in xs {
        sum = wrapping_add(sum, x);
    }
    print_i64(sum);
    print_str("\n");

    if xs.is_empty() {
        print_str("unexpected empty\n");
    }
    if option_i64(xs.first()) != 0 {
        print_str("bad first\n");
    }
    if option_i64(xs.last()) != 9999999 {
        print_str("bad last\n");
    }
    if !xs.set(0, 0) {
        print_str("set failed\n");
    }
    if option_i64(xs.get(0)) != 0 {
        print_str("bad get\n");
    }
    if !xs.contains(0) {
        print_str("missing contains\n");
    }
    if option_i64(xs.index_of(9999999)) != 9999999 {
        print_str("bad index_of\n");
    }
    var extra = []int { 1, 2 };
    xs.extend(extra);
    var copy = xs.slice(0, 3);
    if copy.len() != 3 {
        print_str("bad array\n");
    }
    copy.free();
    xs.free();

    // The M12 string method surface, also outside the measured loop. These
    // checks keep the method resolver and the string runtime entry points in a
    // binary that the feature suite builds and runs.
    var text = "  Yashy,yashy  ";
    var trimmed = text.trim();
    if trimmed.len() != 11 {
        print_str("bad trim\n");
    }
    var upper = text.to_upper();
    if upper.len() != 15 {
        print_str("bad to_upper\n");
    }
    var lower = text.to_lower();
    if lower.len() != 15 {
        print_str("bad to_lower\n");
    }
    var replaced = text.replace("yashy", "seal");
    if replaced.len() != 14 {
        print_str("bad replace\n");
    }
    var piece = text.slice(2, 7);
    if piece.len() != 5 {
        print_str("bad string slice\n");
    }
    var dash = "-";
    var repeated = dash.repeat(3);
    if repeated.len() != 3 {
        print_str("bad repeat\n");
    }
    var parts = text.split(",");
    if parts.len() != 2 {
        print_str("bad split\n");
    }
    parts.free();
    var lines = text.lines();
    if lines.len() != 1 {
        print_str("bad lines\n");
    }
    lines.free();
    if !text.contains("yashy") {
        print_str("missing contains\n");
    }
    if !text.starts_with("  ") {
        print_str("bad starts_with\n");
    }
    if !text.ends_with("  ") {
        print_str("bad ends_with\n");
    }
    if text.byte_at(2) != 89 {
        print_str("bad byte_at\n");
    }
    if option_i64(text.get(2)) != 89 {
        print_str("bad string get\n");
    }
    if option_i64(text.index_of("yashy")) != 8 {
        print_str("bad string index_of\n");
    }
    var empty = "";
    if !empty.is_empty() {
        print_str("empty string is not empty\n");
    }
    var number = "42";
    if number.parse_i64() != 42 {
        print_str("bad parse_i64\n");
    }
    var decimal = "2.5";
    if decimal.parse_f64() != 2.5 {
        print_str("bad parse_f64\n");
    }
}
