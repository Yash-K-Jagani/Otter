// Mapping an array: the same loop in every language, building a new array.
//
// The C, Go and Rust rows build the mapped array the same way -- a second
// array the size of the first -- so the numbers are about the mapping, not
// about how the language grows an array.
fn main() {
    const n = 10000000;
    let xs = []int {};
    let i = 0;
    while i < n {
        xs.push(i);
        i = wrapping_add(i, 1);
    }

    let doubled = xs.map(|x: int| -> int { return x * 2; });

    let sum = 0;
    for x in doubled {
        sum = wrapping_add(sum, x);
    }
    print(sum);
    println("");

    doubled.free();
    xs.free();
}
