// 200,000 channel round trips between the main thread and one worker.
//
// Each channel holds one value, so the two sides strictly alternate: the main
// thread sends, blocks in `recv`, the worker answers, and the main thread
// records the answer. The worker returns after a fixed number of replies, so
// termination needs no closed channel and the join cannot wait on a lost
// wakeup. A lost wakeup anywhere would hang the run; the harness notices.
fn echo(inbox: Channel[int], outbox: Channel[int], rounds: int) {
    var i = 0;
    while i < rounds {
        switch inbox.recv() {
            case Some(n) {
                outbox.send(wrapping_add(n, 1));
            }
            case None {
                outbox.send(0 - 1);
            }
        }
        i = wrapping_add(i, 1);
    }
}

fn main() {
    const rounds = 200000;
    var inbox: Channel[int] = chan_new(1);
    var outbox: Channel[int] = chan_new(1);
    var worker = thread_spawn(echo, inbox, outbox, rounds);

    var i = 0;
    var sum = 0;
    while i < rounds {
        inbox.send(i);
        sum = wrapping_add(sum, switch outbox.recv() {
            case Some(n) {
                n
            }
            case None {
                0 - 1
            }
        });
        i = wrapping_add(i, 1);
    }

    thread_join(worker);
    outbox.free();
    inbox.free();
    print_i64(sum);
    print_str("\n");
}
