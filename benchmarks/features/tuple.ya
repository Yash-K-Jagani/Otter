// Returning two answers as one tuple, 50,000,000 times.
//
// `min_max` returns `(i64, i64)`; the caller destructures it with
// `const (lo, hi) = ...`. The value is an LLVM literal struct, so both halves
// come back in the return value and the destructuring is one extraction per
// name -- no allocation, no out-parameter, no second call.
//
// The printed number is the sum of `3 * lo + hi` over every iteration:
// 3,750,000,000,000,000.
fn min_max(a: i64, b: i64) -> (i64, i64) {
    if a < b {
        return (a, b);
    }
    return (b, a);
}

fn main() {
    const rounds = 50000000;
    var total = 0;
    var i = 0;
    while i < rounds {
        const (lo, hi) = min_max(i, rounds - i);
        total = total + lo * 3 + hi;
        i = i + 1;
    }
    print_i64(total);
    print_str("\n");
}
