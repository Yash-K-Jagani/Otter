// 10,000,000 calls to a method that mutates its receiver through `self`.
//
// The method takes `self: *mut Counter`, so each call passes the counter's
// address rather than a copy: what is measured is the call, the address, and
// the increment -- the shape every mutating method has.

object Counter {
    value: int,

    fn bump(self: *mut Counter) {
        self[0].value = self[0].value + 1;
    },

    fn get(self) -> int {
        return self.value;
    },
}

fn main() {
    let c = Counter { value: 0 };
    let i = 0;
    while i < 10000000 {
        c.bump();
        i = i + 1;
    }
    print(c.get());
    println("");
}
