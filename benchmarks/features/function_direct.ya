// The function.ya loop calling the function directly: the same work, without
// the function value. The difference between this row and the `function` row
// is the price of calling through a value.
fn scale(x: int, k: int) -> int {
    return x * k + x % 3;
}

fn main() {
    const n = 100000000;
    const k = 1000;
    let sum = 0;
    let i = 0;
    while i < n {
        sum = wrapping_add(sum, scale(i, k));
        i = wrapping_add(i, 1);
    }
    print(sum);
    println("");
}
