// The function.ya loop calling through a lambda instead of a named function.
//
// The lambda is written inside the loop, so the value is built on every
// iteration, exactly as the `function.ya` row builds the value of a named
// function on every iteration. The two rows therefore differ in one thing
// only: what the value points at -- a thunk that calls a named function, or
// the lambda's own function.
fn apply(f: fn(int, int) -> int, x: int, k: int) -> int {
    return f(x, k);
}

fn main() {
    const n = 100000000;
    const k = 1000;
    let sum = 0;
    let i = 0;
    while i < n {
        sum = wrapping_add(sum, apply(|x: int, k: int| -> int { return x * k + x % 3; }, i, k));
        i = wrapping_add(i, 1);
    }
    print(sum);
    println("");
}
