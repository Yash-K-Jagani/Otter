// The same fixed-array traversal as `fixed_array.ya`, with `wrapping_add`.
//
// `+` in Yashy is checked: every element add is an overflow test plus a branch,
// and that check is a loop-carried dependency here. `wrapping_add` is the
// statement that the program does not need the check, which is the arithmetic
// the C rows get by default (their signed overflow is undefined, so the
// compiler may reassociate the sum). The pair of rows therefore separates the
// cost of the *array* from the cost of the *checked add*.
fn main() {
    const grid = [1, 2, 3, 4, 5, 6, 7, 8];
    const rounds = 50000000;
    var total = 0;
    var i = 0;
    while i < rounds {
        for value in grid {
            total = wrapping_add(total, value);
        }
        i = wrapping_add(i, 1);
    }
    print_i64(total);
    print_str("\n");
}
