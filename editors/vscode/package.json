{
  "name": "yashy",
  "displayName": "Yashy",
  "description": "Syntax highlighting for the Yashy language",
  "version": "0.1.0",
  "publisher": "yashy",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "yashy",
        "aliases": ["Yashy", "yashy"],
        "extensions": [".ya"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "yashy",
        "scopeName": "source.yashy",
        "path": "./syntaxes/yashy.tmLanguage.json"
      }
    ]
  }
}
